#version 450
/* silu_mul_q.comp — the FFN's middle, done on the GPU so the activation never
 * leaves it.
 *
 * WHY THIS SHADER IS THE WHOLE POINT. The backend could already run a GEMM on
 * the GPU, but every call uploaded activations and downloaded the result, so a
 * three-GEMM FFN paid three round trips AND a CPU-side requantization of the
 * intermediate. That requantization is what pinned the design to the CPU: the
 * down-projection needs int8 activations with per-block scales and sums, and
 * only the CPU could produce them. Nothing else could be kept resident until
 * this existed.
 *
 * From RESEARCH.md 1.3, ggml keeps every intermediate in device buffers for a
 * whole graph and crosses the bus only for model inputs and final logits. This
 * is the smallest useful step in that direction: one fused op that consumes two
 * device buffers and produces the exact activation format the next GEMM wants.
 *
 * It does three things at once because they share the same read:
 *   h = silu(g) * u          the SwiGLU nonlinearity
 *   quantize h to int8       per COLI_ABLK block, scale = amax/127
 *   emit the block sum       which the offset-to-unsigned GEMM needs
 *
 * ONE INVOCATION PER 16-ELEMENT BLOCK. The block is the unit the scale is
 * defined over, so a whole block must be visible to one invocation -- splitting
 * it would need a cross-invocation reduction to find amax, which costs more than
 * the 16 sequential reads it would save.
 *
 * MUST MATCH coli_quantize_a IN gemm_i8.cpp. Same scale (amax/127), same clamp
 * to [-127,127], same sum. The clamp is not cosmetic: lrintf(127.5) is 128 on
 * both glibc and msvcrt, and 128 in an int8 is -128 -- a sign flip on the largest
 * activation in the block. GLSL's round() has the same tie behaviour, so the
 * clamp is required here for the same reason.
 */
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly  buffer G  { float g[];  };   /* [n][I] */
layout(std430, binding = 1) readonly  buffer U  { float u[];  };   /* [n][I] */
layout(std430, binding = 2) writeonly buffer Q  { uint  q[];  };   /* [n][I/4] int8 x4 */
layout(std430, binding = 3) writeonly buffer S  { float s[];  };   /* [n][I/16] */
layout(std430, binding = 4) writeonly buffer M  { int   m[];  };   /* [n][I/16] */

layout(push_constant) uniform P { int I; int O; int n; int nblk; } p;

void main() {
    uint blk = gl_GlobalInvocationID.x;              /* one 16-element block */
    uint total = uint(p.n) * uint(p.nblk);
    if (blk >= total) return;

    uint base = blk * 16u;                           /* element offset; rows are contiguous */

    float h[16];
    float amax = 0.0;
    for (int i = 0; i < 16; i++) {
        float gv = g[base + uint(i)];
        /* silu(x) = x * sigmoid(x). Written as x / (1 + exp(-x)) to match the
         * CPU exactly; exp() here is the GPU's, so this op is NOT bit-exact with
         * the CPU and is not claimed to be -- the whole GPU path is held to a
         * relative bound instead, with a control. */
        float sv = gv / (1.0 + exp(-gv));
        float hv = sv * u[base + uint(i)];
        h[i] = hv;
        amax = max(amax, abs(hv));
    }

    float sc = amax / 127.0;
    if (sc < 1e-12) sc = 1e-12;
    s[blk] = sc;
    float inv = 1.0 / sc;

    int sum = 0;
    uint w[4];
    for (int j = 0; j < 4; j++) {
        uint packed = 0u;
        for (int k = 0; k < 4; k++) {
            int qi = int(round(h[j*4 + k] * inv));
            qi = clamp(qi, -127, 127);               /* see the header: 128 is a sign flip */
            sum += qi;
            packed |= (uint(qi) & 0xFFu) << (k * 8); /* two's complement, low byte */
        }
        w[j] = packed;
    }
    m[blk] = sum;

    uint wbase = blk * 4u;                            /* 16 int8 = 4 uints */
    for (int j = 0; j < 4; j++) q[wbase + uint(j)] = w[j];
}
