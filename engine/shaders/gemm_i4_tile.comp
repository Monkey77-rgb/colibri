#version 450
#extension GL_EXT_integer_dot_product : require
/* gemm_i4_tile.comp — the BATCHED int4 GEMM. Same maths as gemm_i4_dp.comp,
 * completely different shape.
 *
 * WHY A SECOND KERNEL RATHER THAN A PARAMETER ON THE FIRST. gemm_i4_dp is a
 * DECODE kernel and a good one -- at n=1 it runs ffn4 at 409 GB/s, 81% of the
 * 4070's 504 GB/s spec, and four separate attempts to make it faster all
 * regressed. It is near its roofline and should not be touched.
 *
 * It is the wrong shape for PREFILL. Measured 2026-08-23 on ARIAofWebsec
 * (llama-3.1 8B, 683 tokens, RTX 4070): prefill spent 87.5% of its time in
 * GEMMs -- ffn 54.1%, qkv 19.5%, o_proj 13.9% -- and sustained ~1.0 TFLOP/s.
 * llama.cpp did the same work at 3570 tok/s, implying ~49.6 TFLOP/s on the same
 * card. Roughly 50x, on identical silicon and the same dp4a instruction.
 *
 * The gap is ARITHMETIC INTENSITY, not bandwidth, and two cheaper explanations
 * were measured and rejected first:
 *   - widening the existing batch tile: 683-token prefill went 11.50s (tile=1)
 *     -> 10.02s (2) -> 9.86s (4). Saturated; tile=8 was already known to be
 *     WORSE than 4.
 *   - CPU-bound: threads 2 -> 8 -> 15 gave 15.68s -> 10.19s -> 10.86s. A 4x
 *     thread increase bought 1.54x, and 15 is slower than 8.
 * Neither the GPU's weight reuse nor CPU parallelism is the limiter.
 *
 * gemm_i4_dp computes ONE output per 16-lane cluster with at most 4 rows, and
 * reads every operand straight from global memory. Each byte it loads feeds a
 * handful of MACs. This kernel stages a tile of BOTH operands in shared memory
 * and gives each thread a 4x4 output block, so every byte loaded feeds 64 MACs.
 * That is the whole idea; the instruction is the same one.
 *
 * A SECOND SAVING, free with the staging: gemm_i4_dp must deinterleave the even
 * and odd nibbles into two dp4a groups because it reads packed nibbles directly
 * while activations are packed in natural order -- ~6 shuffle ops per word. By
 * expanding weights into shared memory as natural-order int8 ONCE per tile, the
 * shuffle disappears from the inner loop entirely.
 *
 * TILE SHAPE SWEEP, 682-token prefill, ARIAofWebsec v6, RTX 4070. The register
 * tile is the lever and it is TN (outputs per thread), not TM:
 *     TM=4 TN=4  (64x64)    40.3 s
 *     TM=8 TN=4  (128x64)   40.8 s     <- doubling TM does nothing
 *     TM=4 TN=8  (64x128)   20.3 s
 *     TM=8 TN=8  (128x128)  21.7 s     <- and again nothing
 *     TM=4 TN=16 (64x256)   11.2 s     <- current
 * 3.6x from shape alone. TN is what divides the shared-memory traffic per dot;
 * TM only adds activation rows, which a warp already broadcasts.
 *
 * IT REACHES PARITY AND STOPS THERE. Interleaved against the decode kernel on
 * prefill: decode 10.79/10.36/9.83 s, this 10.87/10.41/10.79 s. Both land on the
 * same number, which is the tell that the remaining limit is NOT in either
 * kernel -- see the vk phase profile, where submit+fence is 83.7% and ffn4 alone
 * is 146 ms per call at n=683 (~1.6 TFLOP/s against llama.cpp's implied ~50).
 *
 * STATUS 2026-08-23: CORRECT, AT PARITY, AND OFF BY DEFAULT. 682-token prefill
 * on ARIAofWebsec v6, RTX 4070: decode kernel 11.6 s, this kernel 40.3 s. Four
 * candidate causes were each implemented and each measured, and each is written
 * into the code below rather than deleted, because they are the ones a reader
 * would otherwise try again:
 *   1. uncoalesced weight staging (one row per thread, ~2 KB apart) -> fixed to
 *      4 threads per row, 64 contiguous bytes. 40.7 s -> 39.4 s. Not it.
 *   2. barrier count (2 per 32 K-elements = 256 per row) -> KC 32 to 128, four
 *      times fewer. No measurable change. Not it.
 *   3. shared-memory bank conflicts (row stride 32 uints puts a half-warp on ONE
 *      bank) -> padded to 33. 40.7 s -> 39.4 s. Real, but worth under 4%.
 *   4. register spilling from acc[4][4] not being unrolled -> hand-scalarised to
 *      16 named floats. 39.4 s -> 40.3 s. Not it.
 *
 * WHAT THE ARITHMETIC SAYS IS LEFT. The inner loop does 8 shared loads (4
 * activations + 4 weights) per 16 dp4a, i.e. 0.5 loads per dp4a, or 2 bytes of
 * shared traffic per dot. An SM retires roughly 128 dp4a/clk but serves roughly
 * 128 bytes/clk of shared memory, so this kernel wants ~256 B/clk and gets 128 --
 * it is SHARED-BANDWIDTH bound at about 2x, which is the right order for what is
 * measured. The register tile is too small, not the staging.
 *
 * THE NEXT THING TO TRY, therefore, is a bigger register tile: 4x8 gives 12
 * loads per 32 dp4a (0.375), 8x8 gives 16 per 64 (0.25) and would match the
 * bandwidth. 8x8 needs 64 accumulators, so the open question is whether that
 * fits without spilling -- which is exactly the failure mode item 4 rules out
 * for the 4x4 case but not for 8x8.
 *
 * SCALES. Weights carry one scale per 32 elements, activations one per 16, so a
 * 32-element chunk is exactly one weight block and two activation blocks. The
 * integer accumulator is therefore flushed to float every 16 elements, which is
 * where the scales change -- accumulating integers across a scale boundary would
 * be a different (wrong) function, not a rounding difference.
 */
/* KC=128, not 32. The first version staged 32 K-elements per pass, which cost
 * TWO barriers per 32 elements -- 256 barriers for a 4096-wide row -- and, worse,
 * had each of 64 threads read a DIFFERENT weight row, so the loads landed ~2 KB
 * apart and coalesced into nothing. gemm_i4_dp gets this right by construction:
 * its 64 threads walk consecutive words WITHIN one row. Here the fix is 4 threads
 * per output row, each taking one of the chunk's 4 uvec4, so a warp reads 64
 * contiguous bytes per row. Measured before the fix: 3.4x SLOWER than the kernel
 * it was meant to beat. */
#define TSR 64
#define TSC 256
#define KC  128
#define TM  4
#define TN  16
#define WG  256

layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly  buffer W  { uvec4 w_packed4[]; };
layout(std430, binding = 1) readonly  buffer WS { float w_bscale[];  };
layout(std430, binding = 2) readonly  buffer X  { uint  x_packed[];  };
layout(std430, binding = 3) readonly  buffer XS { float x_scale[];   };
layout(std430, binding = 4) readonly  buffer XM { int   x_sum[];     };
layout(std430, binding = 5) writeonly buffer Y  { float y[];         };

layout(push_constant) uniform P { int I; int O; int n; int nblk; int tile; int outs; } p;

shared uint  As[TSR][KC/4 + 1];
shared uint  Bs[TSC][KC/4 + 1];
shared float Sw[TSC][KC/32];
shared float Sx[TSR][KC/16];

void main() {
    int otiles = (p.O + TSC - 1) / TSC;
    int gid = int(gl_WorkGroupID.x);
    int o0  = (gid % otiles) * TSC;
    int r0  = (gid / otiles) * TSR;
    if (r0 >= p.n) return;
    int lid = int(gl_LocalInvocationID.x);
    int tx  = lid % (TSC/TN);
    int ty  = lid / (TSC/TN);
    int xwords = p.I / 4;
    int wuvec4 = p.I / 32;
    int wnb    = p.I / 32;

    float c0_0=0, c0_1=0, c0_2=0, c0_3=0, c0_4=0, c0_5=0, c0_6=0, c0_7=0, c0_8=0, c0_9=0, c0_10=0, c0_11=0, c0_12=0, c0_13=0, c0_14=0, c0_15=0;
    float c1_0=0, c1_1=0, c1_2=0, c1_3=0, c1_4=0, c1_5=0, c1_6=0, c1_7=0, c1_8=0, c1_9=0, c1_10=0, c1_11=0, c1_12=0, c1_13=0, c1_14=0, c1_15=0;
    float c2_0=0, c2_1=0, c2_2=0, c2_3=0, c2_4=0, c2_5=0, c2_6=0, c2_7=0, c2_8=0, c2_9=0, c2_10=0, c2_11=0, c2_12=0, c2_13=0, c2_14=0, c2_15=0;
    float c3_0=0, c3_1=0, c3_2=0, c3_3=0, c3_4=0, c3_5=0, c3_6=0, c3_7=0, c3_8=0, c3_9=0, c3_10=0, c3_11=0, c3_12=0, c3_13=0, c3_14=0, c3_15=0;

    int chunks = p.I / KC;
    int u4pc   = KC / 32;

    for (int chunk = 0; chunk < chunks; chunk++) {
        int kbase = chunk * KC;
        for (int idx = lid; idx < TSR * (KC/4); idx += WG) {
            int rr = idx / (KC/4), jj = idx % (KC/4);
            int r  = r0 + rr;
            As[rr][jj] = (r < p.n) ? x_packed[r * xwords + kbase/4 + jj] : 0u;
        }
        for (int idx = lid; idx < TSC * u4pc; idx += WG) {
            int o = idx / u4pc, q = idx % u4pc;
            int og = o0 + o;
            if (og < p.O) {
                uvec4 wv4 = w_packed4[og * wuvec4 + chunk*u4pc + q];
                for (int c = 0; c < 4; c++) {
                    uint wv = wv4[c], lo = 0u, hi = 0u;
                    for (int k = 0; k < 4; k++) { int v = int((wv >> (4*k)) & 0xFu) - 8;
                        lo |= (uint(v) & 0xFFu) << (8*k); }
                    for (int k = 0; k < 4; k++) { int v = int((wv >> (4*(k+4))) & 0xFu) - 8;
                        hi |= (uint(v) & 0xFFu) << (8*k); }
                    Bs[o][q*8 + c*2] = lo; Bs[o][q*8 + c*2 + 1] = hi;
                }
                Sw[o][q] = w_bscale[og * wnb + chunk*u4pc + q];
            } else {
                for (int c = 0; c < 8; c++) Bs[o][q*8 + c] = 0u;
                Sw[o][q] = 0.0;
            }
        }
        for (int idx = lid; idx < TSR * (KC/16); idx += WG) {
            int rr = idx / (KC/16), jj = idx % (KC/16);
            int r  = r0 + rr;
            Sx[rr][jj] = (r < p.n) ? x_scale[r * p.nblk + chunk*(KC/16) + jj] : 0.0;
        }
        barrier();
        for (int sub = 0; sub < KC/16; sub++) {
            int s0_0=0, s0_1=0, s0_2=0, s0_3=0, s0_4=0, s0_5=0, s0_6=0, s0_7=0, s0_8=0, s0_9=0, s0_10=0, s0_11=0, s0_12=0, s0_13=0, s0_14=0, s0_15=0;
            int s1_0=0, s1_1=0, s1_2=0, s1_3=0, s1_4=0, s1_5=0, s1_6=0, s1_7=0, s1_8=0, s1_9=0, s1_10=0, s1_11=0, s1_12=0, s1_13=0, s1_14=0, s1_15=0;
            int s2_0=0, s2_1=0, s2_2=0, s2_3=0, s2_4=0, s2_5=0, s2_6=0, s2_7=0, s2_8=0, s2_9=0, s2_10=0, s2_11=0, s2_12=0, s2_13=0, s2_14=0, s2_15=0;
            int s3_0=0, s3_1=0, s3_2=0, s3_3=0, s3_4=0, s3_5=0, s3_6=0, s3_7=0, s3_8=0, s3_9=0, s3_10=0, s3_11=0, s3_12=0, s3_13=0, s3_14=0, s3_15=0;
            int rb = ty*TM, cb = tx*TN;
            for (int w = 0; w < 4; w++) {
                int j = sub*4 + w;
                int x0=int(As[rb+0][j]); int x1=int(As[rb+1][j]); int x2=int(As[rb+2][j]); int x3=int(As[rb+3][j]);
                int b0=int(Bs[cb+0][j]); int b1=int(Bs[cb+1][j]); int b2=int(Bs[cb+2][j]); int b3=int(Bs[cb+3][j]); int b4=int(Bs[cb+4][j]); int b5=int(Bs[cb+5][j]); int b6=int(Bs[cb+6][j]); int b7=int(Bs[cb+7][j]); int b8=int(Bs[cb+8][j]); int b9=int(Bs[cb+9][j]); int b10=int(Bs[cb+10][j]); int b11=int(Bs[cb+11][j]); int b12=int(Bs[cb+12][j]); int b13=int(Bs[cb+13][j]); int b14=int(Bs[cb+14][j]); int b15=int(Bs[cb+15][j]);
                s0_0=dotPacked4x8AccSatEXT(b0,x0,s0_0); s0_1=dotPacked4x8AccSatEXT(b1,x0,s0_1); s0_2=dotPacked4x8AccSatEXT(b2,x0,s0_2); s0_3=dotPacked4x8AccSatEXT(b3,x0,s0_3); s0_4=dotPacked4x8AccSatEXT(b4,x0,s0_4); s0_5=dotPacked4x8AccSatEXT(b5,x0,s0_5); s0_6=dotPacked4x8AccSatEXT(b6,x0,s0_6); s0_7=dotPacked4x8AccSatEXT(b7,x0,s0_7); s0_8=dotPacked4x8AccSatEXT(b8,x0,s0_8); s0_9=dotPacked4x8AccSatEXT(b9,x0,s0_9); s0_10=dotPacked4x8AccSatEXT(b10,x0,s0_10); s0_11=dotPacked4x8AccSatEXT(b11,x0,s0_11); s0_12=dotPacked4x8AccSatEXT(b12,x0,s0_12); s0_13=dotPacked4x8AccSatEXT(b13,x0,s0_13); s0_14=dotPacked4x8AccSatEXT(b14,x0,s0_14); s0_15=dotPacked4x8AccSatEXT(b15,x0,s0_15);
                s1_0=dotPacked4x8AccSatEXT(b0,x1,s1_0); s1_1=dotPacked4x8AccSatEXT(b1,x1,s1_1); s1_2=dotPacked4x8AccSatEXT(b2,x1,s1_2); s1_3=dotPacked4x8AccSatEXT(b3,x1,s1_3); s1_4=dotPacked4x8AccSatEXT(b4,x1,s1_4); s1_5=dotPacked4x8AccSatEXT(b5,x1,s1_5); s1_6=dotPacked4x8AccSatEXT(b6,x1,s1_6); s1_7=dotPacked4x8AccSatEXT(b7,x1,s1_7); s1_8=dotPacked4x8AccSatEXT(b8,x1,s1_8); s1_9=dotPacked4x8AccSatEXT(b9,x1,s1_9); s1_10=dotPacked4x8AccSatEXT(b10,x1,s1_10); s1_11=dotPacked4x8AccSatEXT(b11,x1,s1_11); s1_12=dotPacked4x8AccSatEXT(b12,x1,s1_12); s1_13=dotPacked4x8AccSatEXT(b13,x1,s1_13); s1_14=dotPacked4x8AccSatEXT(b14,x1,s1_14); s1_15=dotPacked4x8AccSatEXT(b15,x1,s1_15);
                s2_0=dotPacked4x8AccSatEXT(b0,x2,s2_0); s2_1=dotPacked4x8AccSatEXT(b1,x2,s2_1); s2_2=dotPacked4x8AccSatEXT(b2,x2,s2_2); s2_3=dotPacked4x8AccSatEXT(b3,x2,s2_3); s2_4=dotPacked4x8AccSatEXT(b4,x2,s2_4); s2_5=dotPacked4x8AccSatEXT(b5,x2,s2_5); s2_6=dotPacked4x8AccSatEXT(b6,x2,s2_6); s2_7=dotPacked4x8AccSatEXT(b7,x2,s2_7); s2_8=dotPacked4x8AccSatEXT(b8,x2,s2_8); s2_9=dotPacked4x8AccSatEXT(b9,x2,s2_9); s2_10=dotPacked4x8AccSatEXT(b10,x2,s2_10); s2_11=dotPacked4x8AccSatEXT(b11,x2,s2_11); s2_12=dotPacked4x8AccSatEXT(b12,x2,s2_12); s2_13=dotPacked4x8AccSatEXT(b13,x2,s2_13); s2_14=dotPacked4x8AccSatEXT(b14,x2,s2_14); s2_15=dotPacked4x8AccSatEXT(b15,x2,s2_15);
                s3_0=dotPacked4x8AccSatEXT(b0,x3,s3_0); s3_1=dotPacked4x8AccSatEXT(b1,x3,s3_1); s3_2=dotPacked4x8AccSatEXT(b2,x3,s3_2); s3_3=dotPacked4x8AccSatEXT(b3,x3,s3_3); s3_4=dotPacked4x8AccSatEXT(b4,x3,s3_4); s3_5=dotPacked4x8AccSatEXT(b5,x3,s3_5); s3_6=dotPacked4x8AccSatEXT(b6,x3,s3_6); s3_7=dotPacked4x8AccSatEXT(b7,x3,s3_7); s3_8=dotPacked4x8AccSatEXT(b8,x3,s3_8); s3_9=dotPacked4x8AccSatEXT(b9,x3,s3_9); s3_10=dotPacked4x8AccSatEXT(b10,x3,s3_10); s3_11=dotPacked4x8AccSatEXT(b11,x3,s3_11); s3_12=dotPacked4x8AccSatEXT(b12,x3,s3_12); s3_13=dotPacked4x8AccSatEXT(b13,x3,s3_13); s3_14=dotPacked4x8AccSatEXT(b14,x3,s3_14); s3_15=dotPacked4x8AccSatEXT(b15,x3,s3_15);
            }
            float w0=Sw[cb+0][sub/2]; float w1=Sw[cb+1][sub/2]; float w2=Sw[cb+2][sub/2]; float w3=Sw[cb+3][sub/2]; float w4=Sw[cb+4][sub/2]; float w5=Sw[cb+5][sub/2]; float w6=Sw[cb+6][sub/2]; float w7=Sw[cb+7][sub/2]; float w8=Sw[cb+8][sub/2]; float w9=Sw[cb+9][sub/2]; float w10=Sw[cb+10][sub/2]; float w11=Sw[cb+11][sub/2]; float w12=Sw[cb+12][sub/2]; float w13=Sw[cb+13][sub/2]; float w14=Sw[cb+14][sub/2]; float w15=Sw[cb+15][sub/2];
            float y0=Sx[rb+0][sub]; float y1=Sx[rb+1][sub]; float y2=Sx[rb+2][sub]; float y3=Sx[rb+3][sub];
            c0_0+=w0*y0*float(s0_0); c0_1+=w1*y0*float(s0_1); c0_2+=w2*y0*float(s0_2); c0_3+=w3*y0*float(s0_3); c0_4+=w4*y0*float(s0_4); c0_5+=w5*y0*float(s0_5); c0_6+=w6*y0*float(s0_6); c0_7+=w7*y0*float(s0_7); c0_8+=w8*y0*float(s0_8); c0_9+=w9*y0*float(s0_9); c0_10+=w10*y0*float(s0_10); c0_11+=w11*y0*float(s0_11); c0_12+=w12*y0*float(s0_12); c0_13+=w13*y0*float(s0_13); c0_14+=w14*y0*float(s0_14); c0_15+=w15*y0*float(s0_15);
            c1_0+=w0*y1*float(s1_0); c1_1+=w1*y1*float(s1_1); c1_2+=w2*y1*float(s1_2); c1_3+=w3*y1*float(s1_3); c1_4+=w4*y1*float(s1_4); c1_5+=w5*y1*float(s1_5); c1_6+=w6*y1*float(s1_6); c1_7+=w7*y1*float(s1_7); c1_8+=w8*y1*float(s1_8); c1_9+=w9*y1*float(s1_9); c1_10+=w10*y1*float(s1_10); c1_11+=w11*y1*float(s1_11); c1_12+=w12*y1*float(s1_12); c1_13+=w13*y1*float(s1_13); c1_14+=w14*y1*float(s1_14); c1_15+=w15*y1*float(s1_15);
            c2_0+=w0*y2*float(s2_0); c2_1+=w1*y2*float(s2_1); c2_2+=w2*y2*float(s2_2); c2_3+=w3*y2*float(s2_3); c2_4+=w4*y2*float(s2_4); c2_5+=w5*y2*float(s2_5); c2_6+=w6*y2*float(s2_6); c2_7+=w7*y2*float(s2_7); c2_8+=w8*y2*float(s2_8); c2_9+=w9*y2*float(s2_9); c2_10+=w10*y2*float(s2_10); c2_11+=w11*y2*float(s2_11); c2_12+=w12*y2*float(s2_12); c2_13+=w13*y2*float(s2_13); c2_14+=w14*y2*float(s2_14); c2_15+=w15*y2*float(s2_15);
            c3_0+=w0*y3*float(s3_0); c3_1+=w1*y3*float(s3_1); c3_2+=w2*y3*float(s3_2); c3_3+=w3*y3*float(s3_3); c3_4+=w4*y3*float(s3_4); c3_5+=w5*y3*float(s3_5); c3_6+=w6*y3*float(s3_6); c3_7+=w7*y3*float(s3_7); c3_8+=w8*y3*float(s3_8); c3_9+=w9*y3*float(s3_9); c3_10+=w10*y3*float(s3_10); c3_11+=w11*y3*float(s3_11); c3_12+=w12*y3*float(s3_12); c3_13+=w13*y3*float(s3_13); c3_14+=w14*y3*float(s3_14); c3_15+=w15*y3*float(s3_15);
        }
        barrier();
    }

    float outv[TM*TN] = float[TM*TN](c0_0,c0_1,c0_2,c0_3,c0_4,c0_5,c0_6,c0_7,c0_8,c0_9,c0_10,c0_11,c0_12,c0_13,c0_14,c0_15,c1_0,c1_1,c1_2,c1_3,c1_4,c1_5,c1_6,c1_7,c1_8,c1_9,c1_10,c1_11,c1_12,c1_13,c1_14,c1_15,c2_0,c2_1,c2_2,c2_3,c2_4,c2_5,c2_6,c2_7,c2_8,c2_9,c2_10,c2_11,c2_12,c2_13,c2_14,c2_15,c3_0,c3_1,c3_2,c3_3,c3_4,c3_5,c3_6,c3_7,c3_8,c3_9,c3_10,c3_11,c3_12,c3_13,c3_14,c3_15);
    for (int a = 0; a < TM; a++) {
        int r = r0 + ty*TM + a;
        if (r >= p.n) continue;
        for (int b = 0; b < TN; b++) {
            int o = o0 + tx*TN + b;
            if (o < p.O) y[r * p.O + o] = outv[a*TN + b];
        }
    }
}
