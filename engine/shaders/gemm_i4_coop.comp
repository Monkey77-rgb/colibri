#version 450
#extension GL_KHR_cooperative_matrix          : require
#extension GL_KHR_memory_scope_semantics      : require
#extension GL_KHR_shader_subgroup_basic       : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
/* gemm_i4_coop.comp — the batched int4 GEMM on the TENSOR CORES.
 *
 * WHY. Measured 2026-08-24, 683-token prefill, ARIAofWebsec v6 (llama-3.1 8B),
 * RTX 4070, same prompt and model for both:
 *     llama.cpp Vulkan   3546-3647 tok/s
 *     Banana (dp4a)        192.6 tok/s
 * 18.8x, and it is NOT an API difference -- llama.cpp's CUDA build on this same
 * box is SLOWER than its Vulkan build (2789.6 tok/s). Its Vulkan banner says
 * "matrix cores: NV_coopmat2". It uses the tensor cores; we use dp4a; that is
 * the gap. tools/coopmat_probe.c confirms this device offers 15 cooperative
 * matrix configurations, so the instruction is there for the taking.
 *
 * WHY fp16 AND NOT THE int8 CONFIG, which exists (M=16 N=16 K=32, sint8 x sint8
 * -> sint32). Because the only int8 K is 32 and our ACTIVATION scales are per
 * COLI_ABLK=16 elements. A single int8 coopmat op would straddle two activation
 * scales, and an int32 accumulator cannot cross a scale boundary -- the sum
 * would be scaled by one block's factor and be wrong for the other half. The
 * alternatives were a 32-element activation requantisation (a format change
 * reaching decode, silu_mul_q and quant.comp, none of which need it) or this:
 * fold BOTH scales into the staged values as fp16 and accumulate in fp32 across
 * the entire K with no rescaling at all. That is also what llama.cpp does for
 * quantised weights, for the same reason.
 *
 * PRECISION, STATED RATHER THAN DISCOVERED LATER. int8 activations and int4
 * weight nibbles are both exactly representable in fp16; their products with the
 * fp32 block scales are NOT, so this path rounds where the dp4a path is exact
 * per block. It is a different function, not a rounding-order difference, and
 * the NLL is expected to move slightly. If it moves a LOT, that is a bug, not
 * precision -- the dp4a kernel's 2.7458 is the reference.
 *
 * SHAPE (current: SGM=1,SGN=2,SGR=2,SGC=4). Workgroup = 256 threads = 8
 * subgroups. Tile = 32 rows x 128 outputs: each subgroup owns SGM x SGN = 1x2
 * 16x16 accumulators (2 row-bands x 4 output-bands, 2 accumulators per
 * subgroup). K is staged 64 at a time (KC), which is 4 coopmat steps of K=16.
 *
 * REGISTER PREFETCH (2026-09-16, goss40). Each chunk iteration used to load
 * that same chunk's global x_packed/x_scale/w_packed4/w_bscale, dequant them
 * into As/Bs, then run the K=16 coopmat steps -- the global loads and the MMAs
 * never overlapped. Now iteration c loads chunk c+1's globals into registers
 * BEFORE running chunk c's MMA steps (so the load is in flight while the MMAs
 * execute), then dequants those already-arrived registers into As/Bs after the
 * MMAs finish. A one-chunk prologue primes As/Bs for chunk 0 before the loop.
 * Arithmetic, K accumulation order, dequant expressions, fp16 rounding points
 * and BPAD padding are byte-for-byte the same as before -- only when the global
 * load is ISSUED moved, not what is computed. */
#define SGM   1           /* 16-row blocks per subgroup */
#define SGN   2           /* 16-output blocks per subgroup */
#define SGR   2           /* subgroups laid out across rows   */
#define SGC   4           /* subgroups laid out across outputs */
#define TSR  (SGR*SGM*16)         /* rows per workgroup    = 32 */
#define TSC  (SGC*SGN*16)         /* outputs per workgroup = 128 */
#define KC   64           /* K elements staged per pass */
#define WG  256           /* 8 subgroups of 32 */
#define BPAD  8           /* pad Bs's k stride (now [out][k], see KP below) */

layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly  buffer W  { uvec4 w_packed4[]; }; /* [O][I/32] */
layout(std430, binding = 1) readonly  buffer WS { float w_bscale[];  }; /* [O][I/32] */
layout(std430, binding = 2) readonly  buffer X  { uint  x_packed[];  }; /* [n][I/4] int8x4 */
layout(std430, binding = 3) readonly  buffer XS { float x_scale[];   }; /* [n][I/16] */
layout(std430, binding = 4) readonly  buffer XM { int   x_sum[];     }; /* unused */
layout(std430, binding = 5) writeonly buffer Y  { float y[];         }; /* [n][O] */

layout(push_constant) uniform P { int I; int O; int n; int nblk; int tile; int outs; } p;

shared float16_t As[TSR * KC];            /* [row][k],  stride KC       */
/* Bs STAGED [out][k], CONTIGUOUS IN k, NOT [k][out] transposed-scatter.
 * v1->v2, measured on bench_gemm_n (see commit message): a work-item
 * dequantizes one uvec4 = 32 CONSECUTIVE k values for one output, so storing
 * them at Bs[o*KP+k] makes those 32 shared writes sequential instead of
 * striding by (TSC+BPAD) elements (272 bytes) between every write -- the old
 * layout turned one dequant into 32 scattered stores. Read side switches from
 * RowMajor (which wanted [k][out]) to ColumnMajor, which is exactly
 * offset = col*stride+row = o*KP+k for this layout -- same math, no transpose
 * needed on read either. KP pads k so 16 tensor-core rows (32 bytes) don't
 * land on a bank-aliasing stride; BPAD is now on k, not on out. */
#define KP (KC + BPAD)
shared float16_t Bs[TSC * KP];             /* [out][k],  stride KP       */
/* THE RESULT GOES THROUGH SHARED, AND WHETHER IT SHOULD DEPENDS ON WHERE y IS.
 * Storing the accumulator straight to y with coopMatStore is legal and needs no
 * staging array -- and measured 9.62 s against 2.72 s for the identical tile
 * while y lived in HOST_CACHED system memory. coopMatStore's element-to-lane
 * mapping is implementation-defined and evidently scatters, so those writes were
 * crossing PCIe in whatever order the hardware liked; landing in shared first
 * and writing out by linear thread index made them coalesced.
 *
 * That says the direct store was waiting on the OUTPUT BUFFER, not on the
 * kernel. Outputs are DEVICE_LOCAL now (see mkbuf_out), so -DCOOP_DIRECT=1
 * compiles the variant that skips Cs entirely and both are kept in the binary,
 * selected by COLI_VK_COOP_DS, because a claim about which is faster on VRAM is
 * a measurement and not a deduction from the one taken on system memory.
 *
 * The edge case is the reason Cs survives even in the direct build: a 16-output
 * block hanging off the end of the matrix cannot be stored whole. The guard is
 * `o0 + TSC <= p.O`, which depends only on gl_WorkGroupID and is therefore
 * WORKGROUP-UNIFORM -- so the barrier inside it is uniform too. An earlier
 * version keyed the same branch off the subgroup's row band, which made the
 * barrier divergent and produced NLL 2.8690 against 2.7433 plus a 3.5x
 * slowdown. Rows need no such care: the output is padded to a multiple of 64
 * rows, so writing into the padding is harmless. */
shared float Cs[TSR * TSC];

void main() {
    int otiles = (p.O + TSC - 1) / TSC;
    int gid = int(gl_WorkGroupID.x);
    int o0  = (gid % otiles) * TSC;
    int r0  = (gid / otiles) * TSR;
    if (r0 >= p.n) return;

    int lid = int(gl_LocalInvocationID.x);
    int sg  = int(gl_SubgroupID);         /* 0..7 */
    int sgr = sg / SGC;                   /* which row band    */
    int sgc = sg % SGC;                   /* which output band */

    int xwords = p.I / 4;
    int wuvec4 = p.I / 32;
    int wnb    = p.I / 32;
    int chunks = p.I / KC;

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[SGM][SGN];
    for (int a = 0; a < SGM; a++) for (int b = 0; b < SGN; b++)
        acc[a][b] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    /* Registers holding the NEXT chunk's globals, loaded ahead of that
     * chunk's dequant -- exactly the per-thread values the old code read
     * inline inside the chunk loop (2 uints of x_packed / 2 floats of
     * x_scale / 1 uvec4 of w_packed4 / 1 float of w_bscale per thread). */
    uint  nx_w0, nx_w1;
    float nx_s0, nx_s1;
    uvec4 nw_v4;
    float nw_sc;

    /* ---- prologue: load + dequant chunk 0 so As/Bs are primed before the
     * loop's first MMA step runs. Identical arithmetic to the steady-state
     * dequant block below. ---- */
    {
        int kbase = 0;
        for (int t = 0; t < 2; t++) {
            int idx = lid + t*WG;
            int rr = idx / (KC/4), jj = idx % (KC/4);
            int r  = r0 + rr;
            uint w  = (r < p.n) ? x_packed[r * xwords + kbase/4 + jj] : 0u;
            float sc = (r < p.n) ? x_scale[r * p.nblk + (kbase + jj*4)/16] : 0.0;
            for (int b = 0; b < 4; b++) {
                int k  = jj*4 + b;
                int q  = int((w >> (8*b)) & 0xFFu);
                if (q > 127) q -= 256;                       /* int8 two's complement */
                As[rr*KC + k] = float16_t(float(q) * sc);
            }
        }
        {
            int idx = lid;
            int o = idx / (KC/32), q4 = idx % (KC/32);
            int og = o0 + o;
            uvec4 wv4 = (og < p.O) ? w_packed4[og * wuvec4 + kbase/32 + q4] : uvec4(0u);
            float ws  = (og < p.O) ? w_bscale[og * wnb + kbase/32 + q4] : 0.0;
            int obase = o * KP, kbase2 = q4*32;
            for (int c = 0; c < 4; c++) {
                uint wv = wv4[c];
                for (int e = 0; e < 8; e++) {
                    int v = int((wv >> (4*e)) & 0xFu) - 8;   /* element sits at bit 4*e */
                    int k = kbase2 + c*8 + e;
                    Bs[obase + k] = float16_t(float(v) * ws);
                }
            }
        }
    }
    barrier();

    for (int chunk = 0; chunk < chunks; chunk++) {
        bool have_next = (chunk + 1 < chunks);   /* workgroup-uniform: same chunks/chunk for every thread */

        /* ---- prefetch chunk+1's globals into registers; issued before the
         * MMA steps below so the load is in flight while they run ---- */
        if (have_next) {
            int kbase = (chunk + 1) * KC;
            for (int t = 0; t < 2; t++) {
                int idx = lid + t*WG;
                int rr = idx / (KC/4), jj = idx % (KC/4);
                int r  = r0 + rr;
                uint w   = (r < p.n) ? x_packed[r * xwords + kbase/4 + jj] : 0u;
                float sc = (r < p.n) ? x_scale[r * p.nblk + (kbase + jj*4)/16] : 0.0;
                if (t == 0) { nx_w0 = w; nx_s0 = sc; } else { nx_w1 = w; nx_s1 = sc; }
            }
            {
                int idx = lid;
                int o = idx / (KC/32), q4 = idx % (KC/32);
                int og = o0 + o;
                nw_v4 = (og < p.O) ? w_packed4[og * wuvec4 + kbase/32 + q4] : uvec4(0u);
                nw_sc = (og < p.O) ? w_bscale[og * wnb + kbase/32 + q4] : 0.0;
            }
        }

        /* ---- tensor-core steps of K=16 on the chunk already staged in
         * As/Bs; each A fragment feeds SGN B fragments ---- */
        for (int kk = 0; kk < KC; kk += 16) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma[SGM];
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb[SGN];
            for (int a = 0; a < SGM; a++)
                coopMatLoad(ma[a], As, ((sgr*SGM + a)*16)*KC + kk, KC,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (int b = 0; b < SGN; b++)
                /* ColumnMajor: offset = col*stride+row = o*KP+k, which is exactly
                 * how Bs is now staged -- see the Bs declaration comment. */
                coopMatLoad(mb[b], Bs, (sgc*SGN + b)*16*KP + kk, KP,
                            gl_CooperativeMatrixLayoutColumnMajor);
            for (int a = 0; a < SGM; a++)
                for (int b = 0; b < SGN; b++)
                    acc[a][b] = coopMatMulAdd(ma[a], mb[b], acc[a][b]);
        }

        barrier();   /* all MMA reads of As/Bs for this chunk are done */

        if (have_next) {
            /* ---- dequant the already-arrived prefetch registers into
             * As/Bs for chunk+1; same expressions as the prologue ---- */
            for (int t = 0; t < 2; t++) {
                int idx = lid + t*WG;
                int rr = idx / (KC/4), jj = idx % (KC/4);
                uint w   = (t == 0) ? nx_w0 : nx_w1;
                float sc = (t == 0) ? nx_s0 : nx_s1;
                for (int b = 0; b < 4; b++) {
                    int k  = jj*4 + b;
                    int q  = int((w >> (8*b)) & 0xFFu);
                    if (q > 127) q -= 256;                       /* int8 two's complement */
                    As[rr*KC + k] = float16_t(float(q) * sc);
                }
            }
            {
                int idx = lid;
                int o = idx / (KC/32), q4 = idx % (KC/32);
                uvec4 wv4 = nw_v4;
                float ws  = nw_sc;
                int obase = o * KP, kbase2 = q4*32;
                for (int c = 0; c < 4; c++) {
                    uint wv = wv4[c];
                    for (int e = 0; e < 8; e++) {
                        int v = int((wv >> (4*e)) & 0xFu) - 8;   /* element sits at bit 4*e */
                        int k = kbase2 + c*8 + e;
                        Bs[obase + k] = float16_t(float(v) * ws);
                    }
                }
            }
        }
        barrier();   /* dequant writes visible before the next iteration's MMA reads */
    }

#ifdef COOP_DIRECT
    /* ---- write out: straight from the accumulator to y ----
     * No barrier and no shared traffic on the common path. The whole-tile test
     * is workgroup-uniform, so the else-branch's barriers are too. */
    if (o0 + TSC <= p.O) {
        for (int a = 0; a < SGM; a++)
            for (int b = 0; b < SGN; b++)
                coopMatStore(acc[a][b], y,
                             (r0 + (sgr*SGM + a)*16) * p.O + o0 + (sgc*SGN + b)*16,
                             p.O, gl_CooperativeMatrixLayoutRowMajor);
    } else {
#endif
    /* ---- write out: coopMatStore into shared, then a coalesced pass to y ---- */
    barrier();
    for (int a = 0; a < SGM; a++)
        for (int b = 0; b < SGN; b++)
            coopMatStore(acc[a][b], Cs, ((sgr*SGM + a)*16)*TSC + (sgc*SGN + b)*16, TSC,
                         gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (int idx = lid; idx < TSR * TSC; idx += WG) {
        int rr = idx / TSC, oo = idx % TSC;
        int r = r0 + rr, o = o0 + oo;
        if (r < p.n && o < p.O) y[r * p.O + o] = Cs[rr*TSC + oo];
    }
#ifdef COOP_DIRECT
    }
#endif
}
