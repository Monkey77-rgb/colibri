#version 450
#extension GL_KHR_shader_subgroup_basic      : require
#extension GL_KHR_shader_subgroup_clustered  : require
#extension GL_KHR_shader_subgroup_arithmetic : require
/* gemm_i4.comp — the int4 GEMM on the GPU, matching coli_gemm_i4 on the CPU.
 *
 * WHY THIS IS AN INTEGER KERNEL AND llama.cpp's IS NOT. Read from the local
 * llama.cpp checkout at c96f608d9 (verified, not recalled): its Vulkan Q4_0 path
 * dequantizes to FLOAT before multiplying --
 *
 *   ggml/src/ggml-vulkan/vulkan-shaders/dequant_funcs.glsl, DATA_A_Q4_0:
 *     vec2 dequantize(...) { return (vec2(vui & 0xF, vui >> 4) - 8.0f); }
 *
 * That is the right call for ggml, which must serve ~20 quant formats through
 * one templated matmul and cannot specialise the arithmetic per format. It costs
 * an int->float conversion per weight. We have exactly one weight format here,
 * so the nibbles stay integer through the dot product and only the block
 * accumulator becomes float -- the same arithmetic shape as the CPU kernel.
 *
 * Whether that is FASTER on this hardware is a measurement, not an argument, and
 * tests/test_vk_gemm.c makes it against the int8 GPU kernel and the CPU.
 *
 * LAYOUT. Weights are the SAME bytes coli_quantize_w4 produced -- two nibbles
 * per byte, each stored as q+8, four bytes per uint32 word, so eight weights per
 * word. No repacking on upload, exactly as the int8 path does it.
 *
 * The block structure divides evenly and that is load-bearing: 8 weights per
 * word, 16 activations per activation-scale block, 32 weights per weight-scale
 * block. One word therefore never straddles either kind of block, so a word can
 * be reduced with a single pair of scales.
 *
 * NOT BIT-EXACT WITH THE CPU, by construction -- the workgroup reduces through
 * shared memory in a tree where the CPU accumulates sequentially. Same exception,
 * same reasoning and same acceptance bound as gemm_i8.comp.
 */
layout(local_size_x = 64) in;

/* Bound as uvec4, not uint: one 16-byte load per thread instead of four 4-byte
 * ones. Same bytes, same layout -- only the load WIDTH changes. Legal because
 * coli_vk_upload_w4 already rejects I % 32 != 0, so words-per-row (I/8) is
 * always a multiple of 4 and a row never starts mid-uvec4. The descriptor is
 * still a plain storage buffer, so the other pipelines sharing this binding are
 * unaffected -- the type is a per-shader interpretation. */
layout(std430, binding = 0) readonly buffer W  { uvec4 w_packed4[]; };  /* [O][I/32] as uvec4 */
layout(std430, binding = 1) readonly buffer WS { float w_bscale[]; };  /* [O][I/32] */
layout(std430, binding = 2) readonly buffer X  { uint  x_packed[]; };  /* [n][I/4]  int8 x4 */
layout(std430, binding = 3) readonly buffer XS { float x_scale[];  };  /* [n][I/16] */
layout(std430, binding = 4) readonly buffer XM { int   x_sum[];    };  /* [n][I/16] — unused here, see below */
layout(std430, binding = 5) writeonly buffer Y { float y[];        };  /* [n][O] */

layout(push_constant) uniform P { int I; int O; int n; int nblk; int tile; int outs; } p;

/* BATCH TILE. Before this, indexing was one workgroup per (r, o) and every
 * workgroup re-read the WHOLE weight row for o. At n=512 that fetched each
 * weight 512 times, so measured cost was linear in n: 0.07 ms at n=1 and
 * 28.79 ms at n=512 on an RTX 4070 (3584x3584), i.e. 0.056 ms/row flat from
 * n=8 upward -- no amortization at all. Weights are the dominant traffic, so
 * the fix is to load a weight word ONCE and reuse it across TILE rows.
 *
 * The tile width arrives in a push constant rather than a #define so the host
 * and the shader cannot drift; MAXTILE only sizes the shared array. */
#define MAXTILE 4
/* One slot per (row, subgroup) instead of per (row, thread): a 64-thread
 * workgroup is 2 subgroups of 32 on NVIDIA, 1 of 64 on AMD wave64. MAXSUB=8
 * covers a 64-thread group on any subgroup size down to 8. */
#define MAXSUB 8
/* LANES PER ROW. Measured 2026-08-20, two shapes with IDENTICAL weight bytes
 * (32 MB) and identical MACs: I=18944,O=3584 walks 9 words per thread and runs
 * at ~326 GB/s in 0.13 ms; I=3584,O=18944 walks 1 and manages ~184 GB/s in
 * 0.23 ms. The kernel can already reach llama.cpp-class bandwidth -- it just
 * cannot when the per-thread walk is one stride long.
 *
 * So SHORTEN the row across fewer lanes rather than giving the workgroup more
 * rows. 16 lanes over I=3584 is 7 strides each instead of 1.75, and a cluster
 * still covers 16*16 = 256 B contiguously. Two earlier attempts at the opposite
 * (32 lanes x 8 rows; 64 lanes x 4 sequential rows) both LOST, because neither
 * lengthened the walk WITHIN one row. */
#define LANES 16


void main() {
    /* one workgroup per (row TILE, group of `outs` outputs); one 16-lane
     * CLUSTER per output, so the cluster's subgroupClusteredAdd is the entire
     * reduction -- no shared memory and no barrier anywhere in this shader. */
    uint gid    = gl_WorkGroupID.x;
    int  outs   = p.outs; if (outs < 1) outs = 1;
    int  otiles = (p.O + outs - 1) / outs;
    int  ot     = int(gid % uint(otiles));
    int  rt     = int(gid / uint(otiles));
    int  cl     = int(gl_LocalInvocationID.x) / LANES;   /* which cluster */
    int  o      = ot * outs + cl;
    int  tile = p.tile; if (tile < 1) tile = 1; if (tile > MAXTILE) tile = MAXTILE;
    int  r0  = rt * tile;
    if (o >= p.O) return;                    /* cluster-uniform */
    if (r0 >= p.n) return;
    int  rn  = p.n - r0; if (rn > tile) rn = tile;   /* the tail tile is short */

    uint lane    = uint(int(gl_LocalInvocationID.x) % LANES);
    int  wwords  = p.I / 8;                  /* weight words: 8 nibbles each */
    int  wwords4 = wwords / 4;               /* the same row counted in uvec4 */
    int  wbase4  = (o * wwords) / 4;
    int  xwords  = p.I / 4;                  /* activation words: 4 int8 each */
    int  wnb     = p.I / 32;                 /* weight scale blocks */

    /* Stride-64 so the 64 threads of a workgroup touch consecutive words, which
     * is what makes the weight read coalesce -- the same access shape as the
     * int8 shader, and the reason this is a strided loop rather than a chunked
     * one. */
    float acc[MAXTILE];
    for (int k = 0; k < MAXTILE; k++) acc[k] = 0.0;

    for (int wj = int(lane); wj < wwords4; wj += LANES) {
        uvec4 wv4 = w_packed4[wbase4 + wj];  /* ONE 16-byte read, reused rn times */

        /* The four words are handled in turn rather than decoded into a q[32]
         * array: the wide LOAD is the point, and a 32-entry per-thread array
         * spills. Each word still sits inside one activation block (16) and one
         * weight block (32), so one pair of scales covers it. */
        for (int c = 0; c < 4; c++) {
            uint wv = wv4[c];
            int  e  = wj * 32 + c * 8;

            int q[8];
            for (int b = 0; b < 8; b++) {
                /* Nibble b of the word: byte b/2, low half first -- the same
                 * order coli_quantize_w4 writes, where element k lands in byte
                 * k/2 with (k & 1) selecting the high nibble. */
                q[b] = int(bitfieldExtract(wv, b * 4, 4)) - 8;
            }

            int   ab = e / 16;
            int   wb = e / 32;
            float ws = w_bscale[o * wnb + wb];

            for (int k = 0; k < MAXTILE; k++) {
                if (k >= rn) break;
                int  xbase = (r0 + k) * xwords;
                uint xw0 = x_packed[xbase + (e / 4)];
                uint xw1 = x_packed[xbase + (e / 4) + 1];
                int s = 0;
                for (int b = 0; b < 8; b++) {
                    uint xw = (b < 4) ? xw0 : xw1;
                    int xq = int(bitfieldExtract(xw, (b & 3) * 8, 8));
                    xq = (xq > 127) ? xq - 256 : xq;        /* int8 sign */
                    s += q[b] * xq;
                }
                acc[k] += ws * x_scale[(r0 + k) * p.nblk + ab] * float(s);
            }
        }
    }

    /* SUBGROUP REDUCTION. The tree above cost six barrier() round trips through
     * shared memory per output. Measured 2026-08-20: cost per workgroup was FLAT
     * at ~47 ns from n=8 to n=512 (0.34 ms / 7,168 wg, 2.67 ms / 57,344 wg,
     * 22.03 ms / 458,752 wg) while each workgroup performed only ~1.75 loop
     * iterations of real work -- the reduction was costing more than the
     * arithmetic it reduced. subgroupAdd does the same fold in one instruction
     * with no barrier; only the per-subgroup partials still need shared memory,
     * and with 64 threads that is at most two values per row. */
    for (int k = 0; k < rn; k++) {
        float v = subgroupClusteredAdd(acc[k], LANES);
        if (lane == 0u) y[(r0 + k) * p.O + o] = v;
    }
    /* No trailing w_scale multiply: int4 carries a scale per BLOCK, already
     * applied above, where int8 carries one per row and applies it here. Binding
     * 4 (x_sum) is likewise unused -- the offset-to-unsigned correction it
     * exists for is a CPU trick for VPDPBUSD's u8xs8 operands, and this shader
     * sign-extends directly. The binding stays so both pipelines share one
     * descriptor set layout. */

}
